  "components": {
    "schemas": {
      "CategoryStatus": {
        "enum": [
          "Active",
          "Inactive"
        ],
        "type": "string",
        "description": "Target status for product category activation or deactivation."
      },
      "CreateCategoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Category name (Required, 2-128 characters, unique per tenant)",
            "nullable": true
          },
          "description": {
            "type": "string",
            "description": "Optional description of category contents or scope",
            "nullable": true
          },
          "status": {
            "type": "string",
            "description": "Initial category status: Active (default) or Inactive",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Request payload for creating a new product category."
