        ],
        "summary": "Update existing product category information with duplicate name prevention. (IBMSBE-014)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Category ID to update",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Updated category fields",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCategoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/categories/{id}/status": {
