        "summary": "Retrieve a paginated list of customers with search, filtering, and sorting.",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "query",
            "description": "Page number for pagination (Default: 1)",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of records per page (Default: 10, Max: 100)",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status: Active, Inactive, or All",
            "schema": {
              "$ref": "#/components/schemas/CustomerStatus"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search text across customer code, name, email, phone, company, or tax ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "customerType",
            "in": "query",
            "description": "Filter by customer type: Business, Individual, or Organization (or All)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "taxId",
            "in": "query",
            "description": "Filter directly by Tax / GST / VAT ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "taxRegistration",
            "in": "query",
            "description": "Filter by tax registration status (Registered, Unregistered, All)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "outstanding",
            "in": "query",
            "description": "Filter by outstanding balance status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "Sort field: createdAt, name, email, companyName, code, updatedAt",
            "schema": {
              "type": "string",
              "default": "createdAt"
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "description": "Sort direction: asc or desc (Default: desc)",
            "schema": {
              "type": "string",
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
